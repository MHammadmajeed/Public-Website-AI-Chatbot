APP_ENV=local
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-frontend-domain.com
APP_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

EMAIL_PROVIDER=resend
RESEND_API_KEY=
LEAD_EMAIL_TO=info@moinsystemsai.com
# Free-tier Resend accounts can only send to the address the account
# was signed up with. During local development, set this to that
# address so you can test email delivery; leave blank in production.
LEAD_EMAIL_DEV_TO=

RATE_LIMIT=60/minute
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.55